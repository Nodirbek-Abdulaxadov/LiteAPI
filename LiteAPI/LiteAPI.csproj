<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PackageId>LiteAPI.Core</PackageId>
		<Title>LiteAPI – Minimal C# Micro Web Framework</Title>
		<Description>A minimal, dependency-free C# micro web framework for building lightweight REST APIs, internal tools, and microservices. 2.3 brings HTTP/1.1 keep-alive in the Rust listener for major throughput and tail-latency wins (~60-100k rps, p99 ≤ 5ms on typical loopback workloads).</Description>
		<PackageTags>csharp;dotnet;restapi;api;minimal;framework;rust</PackageTags>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
		<RootNamespace>LiteAPI</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CA1050;IDE0130;IDE0060;CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\Readme.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!--
		Native assets:
		- Pack=true   → bundled into the NuGet package at runtimes/<rid>/native/
		- Content + CopyToOutputDirectory → propagates to consumer projects via
		  ProjectReference, landing at <consumer-bin>/runtimes/<rid>/native/.
		  The .NET P/Invoke resolver looks under runtimes/<rid>/native/ relative
		  to the entry assembly, so consumers like LiteAPI.Example pick the
		  native up automatically.
		Link is set so the file keeps its runtimes/<rid>/native/ subpath in the
		output instead of getting dumped next to the exe with a flat name.
	-->
	<!--
		Native assets:
		- Pack=true → NuGet payload at runtimes/<rid>/native/ (P/Invoke
		  resolves it from there for NuGet consumers via the package's
		  generated deps.json).
		- CopyToOutputDirectory + Link (flat filename) → ProjectReference
		  consumers like LiteAPI.Example get the native dropped flat next
		  to their exe, which is the first directory P/Invoke searches.
	-->
	<ItemGroup>
		<Content Include="runtimes\win-x64\native\liteapi_rust.dll" Condition="Exists('runtimes\win-x64\native\liteapi_rust.dll')" Pack="true" PackagePath="runtimes/win-x64/native/" CopyToOutputDirectory="PreserveNewest">
			<Link>liteapi_rust.dll</Link>
		</Content>
		<Content Include="runtimes\win-arm64\native\liteapi_rust.dll" Condition="Exists('runtimes\win-arm64\native\liteapi_rust.dll')" Pack="true" PackagePath="runtimes/win-arm64/native/" CopyToOutputDirectory="PreserveNewest">
			<Link>liteapi_rust.dll</Link>
		</Content>
		<Content Include="runtimes\linux-x64\native\libliteapi_rust.so" Condition="Exists('runtimes\linux-x64\native\libliteapi_rust.so')" Pack="true" PackagePath="runtimes/linux-x64/native/" CopyToOutputDirectory="PreserveNewest">
			<Link>libliteapi_rust.so</Link>
		</Content>
		<Content Include="runtimes\linux-arm64\native\libliteapi_rust.so" Condition="Exists('runtimes\linux-arm64\native\libliteapi_rust.so')" Pack="true" PackagePath="runtimes/linux-arm64/native/" CopyToOutputDirectory="PreserveNewest">
			<Link>libliteapi_rust.so</Link>
		</Content>
		<Content Include="runtimes\osx-x64\native\libliteapi_rust.dylib" Condition="Exists('runtimes\osx-x64\native\libliteapi_rust.dylib')" Pack="true" PackagePath="runtimes/osx-x64/native/" CopyToOutputDirectory="PreserveNewest">
			<Link>libliteapi_rust.dylib</Link>
		</Content>
		<Content Include="runtimes\osx-arm64\native\libliteapi_rust.dylib" Condition="Exists('runtimes\osx-arm64\native\libliteapi_rust.dylib')" Pack="true" PackagePath="runtimes/osx-arm64/native/" CopyToOutputDirectory="PreserveNewest">
			<Link>libliteapi_rust.dylib</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LiteAPI.Tests" />
	</ItemGroup>

	<Target Name="CopyRustNativeToRuntimes" BeforeTargets="Build;Pack">
		<PropertyGroup>
			<RustReleaseDir>$(MSBuildProjectDirectory)\liteapi_rust\target\release</RustReleaseDir>
			<RustReleaseDepsDir>$(RustReleaseDir)\deps</RustReleaseDepsDir>
		</PropertyGroup>

		<ItemGroup Condition="'$(OS)' == 'Windows_NT'">
			<_RustWinDll Include="$(RustReleaseDepsDir)\liteapi_rust.dll" />
			<_RustWinDll Include="$(RustReleaseDir)\liteapi_rust.dll" Condition="!Exists('$(RustReleaseDepsDir)\liteapi_rust.dll')" />
		</ItemGroup>
		<Copy Condition="'$(OS)' == 'Windows_NT' and Exists('%(_RustWinDll.Identity)')"
			SourceFiles="%(_RustWinDll.Identity)"
			DestinationFiles="$(MSBuildProjectDirectory)\runtimes\win-x64\native\liteapi_rust.dll"
			SkipUnchangedFiles="true" />

		<Copy Condition="'$(OS)' != 'Windows_NT' and Exists('$(RustReleaseDir)\libliteapi_rust.so')"
			SourceFiles="$(RustReleaseDir)\libliteapi_rust.so"
			DestinationFiles="$(MSBuildProjectDirectory)\runtimes\linux-x64\native\libliteapi_rust.so"
			SkipUnchangedFiles="true" />

		<Copy Condition="'$(OS)' != 'Windows_NT' and Exists('$(RustReleaseDir)\libliteapi_rust.dylib')"
			SourceFiles="$(RustReleaseDir)\libliteapi_rust.dylib"
			DestinationFiles="$(MSBuildProjectDirectory)\runtimes\osx-x64\native\libliteapi_rust.dylib"
			SkipUnchangedFiles="true" />
	</Target>

	<!--
		Project-reference friendliness: ensure the native library is present next to LiteAPI.dll
		after build. `$(TargetDir)` already ends with the platform separator, so no extra `\`.
		The `'$(TargetDir)' != ''` guard skips this target when MSBuild fires `AfterTargets="Build"`
		on the multi-target dispatcher (where TargetDir is empty) — on Linux a hardcoded `\foo`
		gets normalised to `/foo`, which is the root path, which would then 'Access denied' when
		MSBuild tries to write it.
	-->
	<Target Name="CopyRustNativeToOutput" AfterTargets="Build" Condition="'$(TargetDir)' != ''">
		<Copy Condition="'$(OS)' == 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\runtimes\win-x64\native\liteapi_rust.dll')"
			SourceFiles="$(MSBuildProjectDirectory)\runtimes\win-x64\native\liteapi_rust.dll"
			DestinationFiles="$(TargetDir)liteapi_rust.dll"
			SkipUnchangedFiles="true" />

		<Copy Condition="'$(OS)' != 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\runtimes\linux-x64\native\libliteapi_rust.so')"
			SourceFiles="$(MSBuildProjectDirectory)\runtimes\linux-x64\native\libliteapi_rust.so"
			DestinationFiles="$(TargetDir)libliteapi_rust.so"
			SkipUnchangedFiles="true" />

		<Copy Condition="'$(OS)' != 'Windows_NT' and Exists('$(MSBuildProjectDirectory)\runtimes\osx-x64\native\libliteapi_rust.dylib')"
			SourceFiles="$(MSBuildProjectDirectory)\runtimes\osx-x64\native\libliteapi_rust.dylib"
			DestinationFiles="$(TargetDir)libliteapi_rust.dylib"
			SkipUnchangedFiles="true" />
	</Target>
</Project>
